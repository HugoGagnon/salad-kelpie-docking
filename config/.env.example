# LOCAL SUBMITTER SETTINGS
#
# Copy this file to config/.env, fill in the real values, and source it in the
# same terminal before running submit.py or poll.py.
# NEVER commit config/.env — it is gitignored.

# ── Salad credentials ─────────────────────────────────────────────────────────
SALAD_API_KEY=sal_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SALAD_ORGANIZATION=your-org-slug

# ── Container group UUIDs ─────────────────────────────────────────────────────
# Copy from your Salad Portal container-group page.
CPU_CONTAINER_GROUP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GPU_CONTAINER_GROUP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# Use the ACCOUNT-LEVEL endpoint exactly as issued by Cloudflare.
# Do NOT append the bucket name — boto3 adds it separately.
AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_ENDPOINT_URL=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.cloudflarestorage.com
AWS_REGION=auto
R2_BUCKET=your-bucket-name

# ── Campaign namespace ────────────────────────────────────────────────────────
# Required by submit.py (--run-prefix).  Change this whenever the image,
# inputs, or protocol change.  Reuse only to deliberately extend an existing
# run.  A date-stamped slug works well: YYYY-MM-campaign-v1.
# RUN_PREFIX is not sourced automatically — pass it on the CLI.

# ── Kelpie endpoint ───────────────────────────────────────────────────────────
# Leave unchanged unless Salad documents a replacement.
KELPIE_API_URL=https://kelpie.saladexamples.com

# ── Worker container group portal variables ───────────────────────────────────
# The values below are set in the Salad Portal UI (not sourced locally).
# See config/portal.cpu.env.example and config/portal.gpu.env.example for the
# full list of variables that must be entered in the Portal.
