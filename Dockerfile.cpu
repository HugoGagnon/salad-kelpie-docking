# CPU docking image — smina + Kelpie + worker
#
# Lightweight Debian slim base.  No GPU or conda required.
# Build (x86_64, required by Salad nodes):
#   docker build --platform linux/amd64 -f Dockerfile.cpu -t <registry>/docking-cpu:001 .
#
# Resource sizing note: Salad resource requests filter the pool of eligible
# nodes.  Requesting more RAM or CPU than a job actually needs reduces the
# number of machines that match and causes allocation stalls.  Start with the
# defaults in worker/cpu_worker.py and increase only if jobs fail for that
# reason.
FROM debian:bookworm-slim

ARG KELPIE_VERSION=0.6.0
ARG KELPIE_SHA256=c706b8728d6f3a4f71f34a7be531a7d5944894bb6547edb1b661b2b8fd1f47bb
ARG SMINA_URL=https://sourceforge.net/projects/smina/files/smina.static/download
ARG SMINA_SHA256=ffe5e1e78c947f76b0df8805e2c54383d0bbaf2e827a633b643a708cf682a958

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl python3 python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    # Install smina static binary.
    && curl --fail --location --retry 3 "$SMINA_URL" -o /usr/local/bin/smina \
    && echo "${SMINA_SHA256}  /usr/local/bin/smina" | sha256sum --check --strict - \
    && chmod 0755 /usr/local/bin/smina \
    && /usr/local/bin/smina --version \
    # boto3 for multi-job mode R2 access.
    # --break-system-packages is required on Debian bookworm (PEP 668).
    && pip3 install --no-cache-dir --break-system-packages boto3

# Download the pinned Kelpie release and always verify it.
RUN curl --fail --location --retry 3 \
        "https://github.com/SaladTechnologies/kelpie/releases/download/${KELPIE_VERSION}/kelpie" \
        -o /kelpie \
    && echo "${KELPIE_SHA256}  /kelpie" | sha256sum --check --strict - \
    && chmod 0755 /kelpie

WORKDIR /app
RUN mkdir -p /app/worker /app/input /app/outputs /app/data

COPY worker/cpu_worker.py /app/worker/cpu_worker.py
# Bake example data into the image so users can test without uploading inputs.
COPY examples/docking/data/ /app/data/

# Kelpie is the entrypoint.  It reads the job definition, syncs R2 inputs,
# runs worker/cpu_worker.py, then syncs outputs back to R2.
CMD ["/kelpie"]
