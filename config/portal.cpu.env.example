# CPU WORKER CONTAINER GROUP — Portal environment variables
#
# Enter these as SECRETS in the Salad Portal UI for your CPU container group.
# Never commit this file with real values.
# The worker needs a dedicated Salad API key because the platform-JWT path
# can fail in some deployments; set it explicitly as a fallback.
SALAD_API_KEY=sal_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SALAD_ORGANIZATION=your-org-slug
SALAD_PROJECT=your-project-name
SALAD_ORGANIZATION_NAME=your-org-slug
SALAD_PROJECT_NAME=your-project-name
AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_ENDPOINT_URL=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.cloudflarestorage.com
AWS_REGION=auto
R2_BUCKET=your-bucket-name
